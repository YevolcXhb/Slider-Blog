DATABASE_URL="mysql://root:password@localhost:3306/slider_blog"

# 影子库（可选）：仅用于离线校验 prisma/migrations 与 prisma/schema.prisma 是否等价。
# 必须是**可被随意重建的空库**（migrate diff 会在其中重放全部迁移），不要指向生产/开发业务库。
# 留空即禁用该功能，prisma.config.ts 不会写入 shadowDatabaseUrl 字段，现有部署不受影响。
# 用法见 DEPLOY.md「迁移与 schema 的离线等价性校验」小节。
SHADOW_DATABASE_URL=
NEXTAUTH_SECRET="your_nextauth_secret"
# NEXTAUTH_URL removed - use dynamic host (配合 AUTH_TRUST_HOST=true 走动态 host 推断，
# 避免硬编码公网域名后，局域网 IP / SSH 隧道 / 其他域名访问被跨域拦截)
AUTH_TRUST_HOST=true

# 【生产必须启用 HTTPS】生产构建下 NextAuth 会话 cookie 一律带 Secure
# + __Secure- / __Host- 前缀（判定依据是 NODE_ENV，见 src/auth.config.ts 的
# resolveUseSecureCookies），dev（next dev）不受影响、http://localhost:4000 可正常登录。
# 因此生产环境**必须**由 Nginx / Caddy 等终止 TLS 并以 https 对外服务；
# 若生产以明文 http 提供服务，浏览器会直接丢弃带 Secure 的 cookie，
# 表现为「登录成功但立刻跳回登录页」。（此项由 NODE_ENV 自动决定，无需配置变量）

# 管理面板代理共享密钥（admin-proxy.mjs 注入，proxy.ts 校验）
# 生成方式：openssl rand -base64 32
ADMIN_PROXY_SECRET="change_me_openssl_rand_base64_32"

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# Upload：上传目录必须是绝对路径，且位于本项目的 public/ 之下
# （否则 /uploads/** 无法被访问，应用会拒绝写入）。留空则用 public/uploads。
# Docker 部署示例：UPLOAD_DIR=/app/public/uploads
UPLOAD_DIR=

# Redis（可选）：留空即使用**进程内存**限流（当前默认行为，单实例部署无需配置）。
# 仅当需要多实例 / 多副本共享同一份限流计数时才设置，例如：
#   REDIS_URL=redis://localhost:6379/5
# 共享 Redis 上建议指向独立 db（如上面的 /5）或确保使用本项目专属键前缀
# slider-blog:rl:，不要与其他应用共用键空间（本项目只操作带该前缀的键）。
# 注意：Redis 不可用时限流会**降级为每实例内存限流**（请求不会失败），
# 但多实例下实际配额会按副本数放大，详见 DEPLOY.md 的「限流与 Redis」小节。
REDIS_URL=

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@example.com
