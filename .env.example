DATABASE_URL="mysql://root:password@localhost:3306/slider_blog"

# 影子库（可选）：仅用于离线校验 prisma/migrations 与 prisma/schema.prisma 是否等价。
# 必须是**可被随意重建的空库**（migrate diff 会在其中重放全部迁移），不要指向生产/开发业务库。
# 留空即禁用该功能，prisma.config.ts 不会写入 shadowDatabaseUrl 字段，现有部署不受影响。
# 用法见 DEPLOY.md「迁移与 schema 的离线等价性校验」小节。
SHADOW_DATABASE_URL=
NEXTAUTH_SECRET="your_nextauth_secret"
# NEXTAUTH_URL removed - use dynamic host (配合 AUTH_TRUST_HOST=true 走动态 host 推断，
# 避免硬编码公网域名后，局域网 IP / SSH 隧道 / 其他域名访问被跨域拦截)
AUTH_TRUST_HOST=true

# 【生产必须启用 HTTPS】生产构建下 NextAuth 会话 cookie 一律带 Secure
# + __Secure- / __Host- 前缀（判定依据是 NODE_ENV，见 src/auth.config.ts 的
# resolveUseSecureCookies），dev（next dev）不受影响、http://localhost:4000 可正常登录。
# 因此生产环境**必须**由 Nginx / Caddy 等终止 TLS 并以 https 对外服务；
# 若生产以明文 http 提供服务，浏览器会直接丢弃带 Secure 的 csrf cookie，
# 导致 CSRF 双提交校验失败、登录**恒定报错**（POST /api/auth/callback/credentials
# 始终返回 error=MissingCSRF，密码根本没被校验过），修复方式见下方
# AUTH_COOKIE_SECURE 逃生舱。（此项由 NODE_ENV 自动决定，无需配置变量）
#
# 纠错说明：早期文档把该症状写成「登录成功但立刻跳回登录页」，实测**并非如此** ——
# 登录请求在 CSRF 阶段就硬失败，从未成功过。按旧描述排查会误判成会话/跳转问题。
#
# ── 逃生舱：AUTH_COOKIE_SECURE（可选，仅限可信内网）────────────────────────
# 上面的「必须 HTTPS」对**公网**部署依然成立，本变量不是它的否定，而是一条
# 受控例外：让没有 TLS 的**局域网/内网**部署也能登录。默认不设置，行为与上面
# 完全一致（生产=Secure，dev=非 Secure），不影响任何 HTTPS 部署。
#
#   未设置 / 空 / 其它任何值 -> 由 NODE_ENV 决定（生产 = Secure，默认）
#   AUTH_COOKIE_SECURE=false -> 关闭 Secure 与 __Secure- / __Host- 前缀，
#                               使 http://<host>:<port>/ 的明文访问可以正常登录
#   AUTH_COOKIE_SECURE=true  -> 强制开启（一般无需设置）
#
# 什么时候需要设成 false：站点在局域网/内网用 http:// 访问，没有 TLS 终止，
# 用户浏览器地址栏是 http:// 而非 https://。此时若不设，登录会恒定失败并返回
# MissingCSRF —— 注意这**不是**密码错误，而是 csrf cookie 被浏览器丢弃。
#
# ⚠ 安全代价（务必读完再决定）：设为 false 后会话 cookie 不再带 Secure，
#   同一局域网内的任何中间人（ARP 欺骗、Wi-Fi 嗅探、被入侵的路由/交换机）
#   都能明文截获 authjs.session-token，从而直接冒用管理员身份。
#   因此它**仅适用于你完全掌控、且确认无可信度问题的内网**。
#   一旦站点暴露到公网、或接上了 HTTPS，**必须删掉这一行**（回到默认），
#   否则等于主动放弃了 cookie 的传输层保护。
#
# 写在哪里：推荐写进容器的 /data/config.env（entrypoint 会 source 并 export
# 给 node 进程）；也可以用 docker run -e AUTH_COOKIE_SECURE=false 传入。
# 该变量在进程启动时读取，**改完必须重启容器/进程**才生效。
#
# 值只认小写字面量 "false" / "true"（严格字符串比较）：写 FALSE、0、no 都**不会**
# 关闭 Secure，而是保守地退回默认行为 —— 这是刻意的，避免误拼写静默降级安全性。
#
# AUTH_COOKIE_SECURE=false

# 管理面板代理共享密钥（admin-proxy.mjs 注入，proxy.ts 校验）
# 生成方式：openssl rand -base64 32
ADMIN_PROXY_SECRET="change_me_openssl_rand_base64_32"

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# Upload：上传目录必须是绝对路径，且位于本项目的 public/ 之下
# （否则 /uploads/** 无法被访问，应用会拒绝写入）。留空则用 public/uploads。
# Docker 部署示例：UPLOAD_DIR=/app/public/uploads
UPLOAD_DIR=

# Redis（可选）：留空即使用**进程内存**限流（当前默认行为，单实例部署无需配置）。
# 仅当需要多实例 / 多副本共享同一份限流计数时才设置，例如：
#   REDIS_URL=redis://localhost:6379/5
# 共享 Redis 上建议指向独立 db（如上面的 /5）或确保使用本项目专属键前缀
# slider-blog:rl:，不要与其他应用共用键空间（本项目只操作带该前缀的键）。
# 注意：Redis 不可用时限流会**降级为每实例内存限流**（请求不会失败），
# 但多实例下实际配额会按副本数放大，详见 DEPLOY.md 的「限流与 Redis」小节。
REDIS_URL=

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@example.com
